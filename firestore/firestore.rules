rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ────────────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return request.auth.uid == uid;
    }

    // Returns true if the two users have an accepted interest in either direction
    function hasMutualMatch(uid1, uid2) {
      return exists(/databases/$(database)/documents/interests/$(uid1 + "_" + uid2))
          || exists(/databases/$(database)/documents/interests/$(uid2 + "_" + uid1));
    }

    // Check that incoming data only contains allowed fields
    function hasOnly(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    // ─── Users collection ───────────────────────────────────────────────────
    match /users/{uid} {

      // Anyone signed in can read a visible, complete profile
      allow read: if isSignedIn()
                  && (isOwner(uid)
                      || (resource.data.profileVisible == true
                          && resource.data.profileComplete == true));

      // Only the profile owner can create or update their own document
      allow create: if isSignedIn()
                    && isOwner(uid)
                    && request.resource.data.uid == uid;

      allow update: if isSignedIn()
                    && isOwner(uid)
                    // Prevent changing uid or email via update
                    && request.resource.data.uid == uid
                    && request.resource.data.email == resource.data.email;

      // No deletes through client SDK — use Admin SDK / Cloud Functions
      allow delete: if false;
    }

    // ─── Interests collection ────────────────────────────────────────────────
    match /interests/{interestId} {

      // Sender or recipient can read
      allow read: if isSignedIn()
                  && (request.auth.uid == resource.data.fromUid
                      || request.auth.uid == resource.data.toUid);

      // Only the sender can create; they must set themselves as fromUid
      // and status must start as "pending"
      allow create: if isSignedIn()
                    && request.resource.data.fromUid == request.auth.uid
                    && request.resource.data.status  == "pending"
                    && request.resource.data.toUid   != request.auth.uid;

      // Only the recipient can accept/decline (update status field only)
      allow update: if isSignedIn()
                    && request.auth.uid == resource.data.toUid
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(["status", "updatedAt"])
                    && request.resource.data.status in ["accepted", "declined"];

      allow delete: if false;
    }

    // ─── Conversations collection ────────────────────────────────────────────
    match /conversations/{convId} {

      // Only participants can read the conversation
      allow read: if isSignedIn()
                  && request.auth.uid in resource.data.participants;

      // Only a participant of an accepted interest may create a conversation
      allow create: if isSignedIn()
                    && request.auth.uid in request.resource.data.participants
                    && request.resource.data.participants.size() == 2;

      // Participants can update metadata (lastMessage, unreadCount)
      allow update: if isSignedIn()
                    && request.auth.uid in resource.data.participants
                    && request.resource.data.participants == resource.data.participants;

      allow delete: if false;

      // ─── Messages sub-collection ─────────────────────────────────────────
      match /messages/{messageId} {

        // Only conversation participants can read messages
        allow read: if isSignedIn()
                    && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participants;

        // Only the sender can create a message; must set themselves as senderUid
        allow create: if isSignedIn()
                      && request.resource.data.senderUid == request.auth.uid
                      && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participants
                      && request.resource.data.text.size() > 0
                      && request.resource.data.text.size() <= 1000;

        allow update: if false;
        allow delete: if false;
      }
    }

    // ─── Notifications collection ────────────────────────────────────────────
    match /notifications/{notifId} {

      // Only the notification owner can read
      allow read: if isSignedIn()
                  && request.auth.uid == resource.data.uid;

      // Only server-side (Admin SDK) should create notifications
      // Clients may mark as read
      allow create: if false;

      allow update: if isSignedIn()
                    && request.auth.uid == resource.data.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["read"]);

      allow delete: if false;
    }

  }
}
